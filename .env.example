BOT_TOKEN=
ALLOWED_HOSTS=instagram.com,www.instagram.com,tiktok.com,www.tiktok.com,m.tiktok.com,vm.tiktok.com,vt.tiktok.com,youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be
INSECURE_SKIP_VERIFY=false
MAX_DOWNLOAD_MB=200
MAX_CONCURRENT_DOWNLOADS=3
ENV=production
PROXY=
YT_DLP_VERSION=2026.10.26
DATABASE_URL=postgres://xa4y:changeme@localhost:55432/vidsave?sslmode=disable
POSTGRES_PASSWORD=changeme

# /stats owner allowlist; get your numeric user ID via /id in a private bot chat
ADMIN_TELEGRAM_IDS=

# Enable owner-only Telegram Widget /stats after staging validation (default: false)
ANALYTICS_WIDGET_ENABLED=false

# Stage 3: keep disabled until PR CI and owner Telegram E2E pass
DOWNLOAD_WIDGET_ENABLED=false
MAX_WAITING_DOWNLOADS=6
DOWNLOAD_QUEUE_TIMEOUT_SEC=20
DOWNLOAD_TIMEOUT_SEC=240
DOWNLOAD_USER_COOLDOWN_SEC=3
DOWNLOAD_SOURCE_COOLDOWN_SEC=30
DOWNLOAD_GROUP_PER_MINUTE=20

# With widgets enabled, only these Telegram IDs use the new UX; empty = everyone
DOWNLOAD_WIDGET_PILOT_IDS=

# Stage 4: informative error widgets; safe local-only format button
ERROR_WIDGET_ENABLED=false
